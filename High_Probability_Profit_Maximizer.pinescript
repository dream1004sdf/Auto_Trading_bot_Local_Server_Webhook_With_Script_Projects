//@version=5
indicator("Enhanced Profit Maximizer with Refined Debugging", overlay=true)

// Input parameters
rsiPeriod = input.int(14, title="RSI Period")
rsiOverbought = input.int(70, title="RSI Overbought")
rsiOversold = input.int(30, title="RSI Oversold")

macdFastLength = input.int(12, title="MACD Fast Length")
macdSlowLength = input.int(26, title="MACD Slow Length")
macdSignalLength = input.int(9, title="MACD Signal Length")

bbLength = input.int(20, title="BB Length")
bbMult = input.float(2.0, title="BB Multiplier")

rollingHours = input.int(14 * 24, title="Rolling Hours (14 Days)")

optimizedStopLossPercent = input.float(2.0, title="Optimized Stop Loss (%)")
optimizedProfitTargetPercent = input.float(4.0, title="Optimized Profit Target (%)")
optimizedTrailStopPercent = input.float(1.0, title="Optimized Trail Stop (%)")

// Rolling data
rollingData = math.min(rollingHours, 15000)
rollingHigh = ta.highest(high, rollingData)
rollingLow = ta.lowest(low, rollingData)
rollingRange = rollingHigh - rollingLow
rollingVolatilityPercent = (rollingRange / close) * 100

// Calculations
rsiValue = ta.rsi(close, rsiPeriod)
[macdLine, signalLine, _] = ta.macd(close, macdFastLength, macdSlowLength, macdSignalLength)
upperBB = ta.sma(close, bbLength) + bbMult * ta.stdev(close, bbLength)
lowerBB = ta.sma(close, bbLength) - bbMult * ta.stdev(close, bbLength)

// Reverse strategy logic
reverseEnterLong = ta.crossunder(macdLine, signalLine) and rsiValue > rsiOverbought and close > upperBB
reverseExitLong = ta.crossover(macdLine, signalLine) or rsiValue < rsiOversold or close < lowerBB

reverseEnterShort = ta.crossover(macdLine, signalLine) and rsiValue < rsiOversold and close < lowerBB
reverseExitShort = ta.crossunder(macdLine, signalLine) or rsiValue > rsiOverbought or close > upperBB

// Track signal changes
var bool lastReverseEnterLong = na
var bool lastReverseEnterShort = na

newReverseLong = reverseEnterLong and not lastReverseEnterLong
newReverseShort = reverseEnterShort and not lastReverseEnterShort

lastReverseEnterLong := reverseEnterLong
lastReverseEnterShort := reverseEnterShort

// Dynamic risk parameters
var float reverseStopLoss = na
var float reverseProfitTarget = na
var float reverseTrailStop = na

if newReverseLong
    reverseStopLoss := close * (1 - (optimizedStopLossPercent / 100))
    reverseProfitTarget := close * (1 + (optimizedProfitTargetPercent / 100))
    reverseTrailStop := close * (1 - (optimizedTrailStopPercent / 100))

if newReverseShort
    reverseStopLoss := close * (1 + (optimizedStopLossPercent / 100))
    reverseProfitTarget := close * (1 - (optimizedProfitTargetPercent / 100))
    reverseTrailStop := close * (1 + (optimizedTrailStopPercent / 100))


// Streamlined Labels
if newReverseLong
    label.new(bar_index, low, text="Rev Buy", style=label.style_label_up, color=color.green)
if reverseExitLong
    label.new(bar_index, high, text="Rev Sell", style=label.style_label_down, color=color.red)

if newReverseShort
    label.new(bar_index, high, text="Rev Sell", style=label.style_label_down, color=color.orange)
if reverseExitShort
    label.new(bar_index, low, text="Rev Buy", style=label.style_label_up, color=color.purple)

// Alerts
alertcondition(newReverseLong, title="Reverse Enter Long Alert", message="Reverse Long Entry Detected")
alertcondition(reverseExitLong, title="Reverse Exit Long Alert", message="Reverse Long Exit Detected")
alertcondition(newReverseShort, title="Reverse Enter Short Alert", message="Reverse Short Entry Detected")
alertcondition(reverseExitShort, title="Reverse Exit Short Alert", message="Reverse Short Exit Detected")

// Plot reverse signals
plotshape(series=newReverseLong, title="Reverse Enter Long", style=shape.labelup, location=location.belowbar, color=color.green, text="Rev Buy")
plotshape(series=reverseExitLong, title="Reverse Exit Long", style=shape.labeldown, location=location.abovebar, color=color.red, text="Rev Sell")
plotshape(series=newReverseShort, title="Reverse Enter Short", style=shape.labeldown, location=location.abovebar, color=color.orange, text="Rev Sell")
plotshape(series=reverseExitShort, title="Reverse Exit Short", style=shape.labelup, location=location.belowbar, color=color.purple, text="Rev Buy")
