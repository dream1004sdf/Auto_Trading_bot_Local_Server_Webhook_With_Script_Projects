//@version=6
strategy('Scalping Multi-Symbol Strategy', overlay = true)

// Webhook Parameters
api_key = '122333444'
api_secret = '1233454567'
exchange = 'GDAX'
symbol = 'GDAX_USD_' + syminfo.basecurrency

// Backtesting Parameters
useCustomDates = input.bool(false, 'Use Custom Dates')
customStartDate = input.time(timestamp('2024-12-01 00:00:00'), 'Custom Start Date')
customEndDate = input.time(timestamp('2024-12-22 23:59:59'), 'Custom End Date')
rollingPeriodMinutes = input.int(3 * 24 * 60, 'Rolling Period (minutes)')
defaultBacktestStart = timenow - rollingPeriodMinutes * 60 * 1000
backtestStart = useCustomDates ? customStartDate : defaultBacktestStart
backtestEnd = useCustomDates ? customEndDate : timenow

inTestingRange = (time >= backtestStart and time <= backtestEnd)

// Custom EMA function
f_dynamic_ema(src, dynamicLength) =>
    var float prevEma = na
    alpha = 2 / (dynamicLength + 1)
    prevEma := na(prevEma[1]) ? src : alpha * src + (1 - alpha) * prevEma[1]
    prevEma

// Slippage calculation based on market data
slippagePercent = ta.stdev(close, 20) / close * 100  // Dynamic slippage calculation as a percentage
slippageMultiplier = 1 + slippagePercent / 100

// Tight stop-loss and take-profit multiplier for scalping
scalpingMultiplier = 0.5

// Function to calculate Stochastic Oscillator
f_calc_stochastic(src, highInput, lowInput, length) =>
    k = ta.stoch(close, highInput, lowInput, length)
    d = ta.sma(k, 3)
    [k, d]

// Function to calculate RSI
f_rsi(src, length) =>
    rsi = ta.rsi(src, length)
    rsi

// Function to calculate Supertrend
f_supertrend(length, multiplier) =>
    [supertrend, direction] = ta.supertrend(length, multiplier)
    [supertrend, direction]

// Adding VWAP, RSI, Supertrend, and Stochastic Oscillator for each symbol
DOGEUSD = request.security('COINBASE:DOGEUSD', '1', close)
DOGEVWAP = ta.vwap(DOGEUSD)
DOGERSI = f_rsi(DOGEUSD, 14)
[DOGESupertrend, DOGEDirection] = f_supertrend(10, 2)
[DOGEK, DOGED] = f_calc_stochastic(DOGEUSD, ta.highest(DOGEUSD, 14), ta.lowest(DOGEUSD, 14), 14)
DOGEStopLoss = ta.lowest(DOGEUSD, 10) * slippageMultiplier
DOGETakeProfit = ta.highest(DOGEUSD, 10) * slippageMultiplier

// DOGEUSD Trading Logic
if inTestingRange and DOGERSI > 30 and DOGERSI < 70 and DOGEVWAP > DOGEUSD
    if DOGEUSD > DOGESupertrend and DOGERSI > 50 and DOGEK > 20 and DOGED > 20
        strategy.entry('DOGEUSD Long', strategy.long)
        strategy.exit('DOGEUSD Long Exit', from_entry = 'DOGEUSD Long', stop = DOGEStopLoss, limit = DOGETakeProfit)
        alert('Bought DOGEUSD at ' + str.tostring(DOGEUSD) + ', Limit Price: ' + str.tostring(DOGETakeProfit) + ', Quantity: ' + str.tostring(strategy.position_size), alert.freq_once_per_bar_close)
    if DOGEUSD < DOGESupertrend and DOGERSI < 50 and DOGEK < 80 and DOGED < 80
        strategy.entry('DOGEUSD Short', strategy.short)
        strategy.exit('DOGEUSD Short Exit', from_entry = 'DOGEUSD Short', stop = DOGEStopLoss, limit = DOGETakeProfit)
        alert('Sold DOGEUSD at ' + str.tostring(DOGEUSD) + ', Limit Price: ' + str.tostring(DOGETakeProfit) + ', Quantity: ' + str.tostring(strategy.position_size), alert.freq_once_per_bar_close)

// Plots for DOGEUSD
plot(DOGEVWAP, title = "DOGEUSD VWAP", color = color.blue, linewidth = 1)
plot(DOGERSI, title = "DOGEUSD RSI", color = color.purple, linewidth = 1)
plot(DOGESupertrend, title = "DOGEUSD Supertrend", color = color.green, linewidth = 1)
plot(DOGEK, title = "DOGEUSD Stochastic K", color = color.purple, linewidth = 1)
plot(DOGED, title = "DOGEUSD Stochastic D", color = color.yellow, linewidth = 1)

// Repeat logic for SOLUSD
SOLUSD = request.security('COINBASE:SOLUSD', '1', close)
SOLVWAP = ta.vwap(SOLUSD)
SOLRSI = f_rsi(SOLUSD, 14)
[SOLSupertrend, SOLDirection] = f_supertrend(10, 2)
[SOLK, SOLD] = f_calc_stochastic(SOLUSD, ta.highest(SOLUSD, 14), ta.lowest(SOLUSD, 14), 14)
SOLStopLoss = ta.lowest(SOLUSD, 10) * slippageMultiplier
SOLTakeProfit = ta.highest(SOLUSD, 10) * slippageMultiplier

if inTestingRange and SOLRSI > 30 and SOLRSI < 70 and SOLVWAP > SOLUSD
    if SOLUSD > SOLSupertrend and SOLRSI > 50 and SOLK > 20 and SOLD > 20
        strategy.entry('SOLUSD Long', strategy.long)
        strategy.exit('SOLUSD Long Exit', from_entry = 'SOLUSD Long', stop = SOLStopLoss, limit = SOLTakeProfit)
        alert('Bought SOLUSD at ' + str.tostring(SOLUSD) + ', Limit Price: ' + str.tostring(SOLTakeProfit) + ', Quantity: ' + str.tostring(strategy.position_size), alert.freq_once_per_bar_close)
    if SOLUSD < SOLSupertrend and SOLRSI < 50 and SOLK < 80 and SOLD < 80
        strategy.entry('SOLUSD Short', strategy.short)
        strategy.exit('SOLUSD Short Exit', from_entry = 'SOLUSD Short', stop = SOLStopLoss, limit = SOLTakeProfit)
        alert('Sold SOLUSD at ' + str.tostring(SOLUSD) + ', Limit Price: ' + str.tostring(SOLTakeProfit) + ', Quantity: ' + str.tostring(strategy.position_size), alert.freq_once_per_bar_close)

plot(SOLVWAP, title = "SOLUSD VWAP", color = color.blue, linewidth = 1)
plot(SOLRSI, title = "SOLUSD RSI", color = color.purple, linewidth = 1)
plot(SOLSupertrend, title = "SOLUSD Supertrend", color = color.green, linewidth = 1)
plot(SOLK, title = "SOLUSD Stochastic K", color = color.purple, linewidth = 1)
plot(SOLD, title = "SOLUSD Stochastic D", color = color.yellow, linewidth = 1)

