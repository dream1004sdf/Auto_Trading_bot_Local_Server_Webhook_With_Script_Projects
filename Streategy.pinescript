ATOMUSD = request.security('COINBASE:ATOMUSD', '1', close)
ATOMVWAP = ta.vwap(ATOMUSD)
ATOMRSI = f_rsi(ATOMUSD, 14)
[ATOMSupertrend, ATOMDirection] = f_supertrend(10, 2)
