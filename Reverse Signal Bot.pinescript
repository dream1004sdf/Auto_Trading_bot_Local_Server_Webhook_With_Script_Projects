//@version=5
strategy("Reverse Signal Bot Strategy", overlay=true, initial_capital=1000, margin_long=2, margin_short=2, calc_on_order_fills=true, calc_on_every_tick=true)

// === INPUTS & INDICATOR CALCULATIONS ===

// Moving Average (SMA)
smaLength = input.int(50, "SMA Length", minval=1)
smaValue = ta.sma(close, smaLength)

// RSI
rsiLength      = input.int(14, "RSI Length", minval=1)
rsiOverbought  = input.int(75, "RSI Overbought Level")  // Increased for stronger signal
rsiOversold    = input.int(25, "RSI Oversold Level")    // Lowered for better reversal
rsiValue       = ta.rsi(close, rsiLength)

// Bollinger Bands
bbLength = input.int(20, "BB Length", minval=1)
bbMult   = input.float(2.0, "BB Multiplier", step=0.1)
basis    = ta.sma(close, bbLength)
dev      = bbMult * ta.stdev(close, bbLength)
upperBB  = basis + dev
lowerBB  = basis - dev

// OBV (On Balance Volume)
priceChange = ta.change(close)
obvValue = ta.cum(volume * (priceChange > 0 ? 1 : priceChange < 0 ? -1 : 0))
obvTrend  = ta.sma(obvValue, 14)

// Ichimoku Cloud
conversionLine = (ta.highest(high, 9) + ta.lowest(low, 9)) / 2
baseLine       = (ta.highest(high, 26) + ta.lowest(low, 26)) / 2
leadingSpanA   = (conversionLine + baseLine) / 2
leadingSpanB   = (ta.highest(high, 52) + ta.lowest(low, 52)) / 2

// MACD
[macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)

// Fibonacci Retracement Levels
fibHigh     = ta.highest(high, 100)
fibLow      = ta.lowest(low, 100)
fib236      = fibLow + 0.236 * (fibHigh - fibLow)
fib618      = fibLow + 0.618 * (fibHigh - fibLow)

// Stochastic Oscillator
kValue    = ta.sma(ta.stoch(close, high, low, 14), 3)
dValue    = ta.sma(kValue, 3)

// Aroon Indicator
aroonUp   = 100 * (25 - ta.barssince(high == ta.highest(high, 25))) / 25
aroonDown = 100 * (25 - ta.barssince(low  == ta.lowest(low, 25))) / 25

// === SIGNAL COMPOSITION ===
var float bullishCount = 0
var float bearishCount = 0
bullishCount := 0
bearishCount := 0

// 1. Moving Average
if close > smaValue
    bullishCount += 1
else
    bearishCount += 1

// 2. RSI
if rsiValue < rsiOversold
    bullishCount += 1
else if rsiValue > rsiOverbought
    bearishCount += 1

// 3. Bollinger Bands
if close < lowerBB
    bullishCount += 1
else if close > upperBB
    bearishCount += 1

// 4. OBV Trend
if obvValue > obvTrend
    bullishCount += 1
else
    bearishCount += 1

// 5. Ichimoku Cloud
if close > leadingSpanA and close > leadingSpanB
    bullishCount += 1
else if close < leadingSpanA and close < leadingSpanB
    bearishCount += 1

// 6. MACD
if macdLine > signalLine
    bullishCount += 1
else
    bearishCount += 1

// 7. Fibonacci Levels
if math.abs(close - fib618) < (fib618 * 0.005)  // 0.5% proximity
    bullishCount += 1
if math.abs(close - fib236) < (fib236 * 0.005)
    bearishCount += 1

// 8. Stochastic
if ta.crossover(kValue, dValue) and kValue < 20
    bullishCount += 1
if ta.crossunder(kValue, dValue) and kValue > 80
    bearishCount += 1

// 9. Aroon Indicator
if aroonUp > aroonDown
    bullishCount += 1
else if aroonDown > aroonUp
    bearishCount += 1

// 10. Strengthen Signal Filtering (Confirmations)
bullishCondition = (bullishCount > bearishCount) and (rsiValue < 50) and ta.crossover(macdLine, signalLine) and (close < lowerBB)
bearishCondition = (bearishCount > bullishCount) and (rsiValue > 50) and ta.crossunder(macdLine, signalLine) and (close > upperBB)

// === STOP-LOSS & TAKE-PROFIT ===
stopLoss = close * 0.95  // 2% stop loss
takeProfit = close * 1.05 // 2% take profit

// === TRADE EXECUTION (Reverse Strategy) ===
if bullishCondition and strategy.position_size <= 0
    strategy.entry("Long", strategy.long, comment="Long Entry")
    strategy.exit("Exit Long", from_entry="Long", stop=stopLoss, limit=takeProfit)

if bearishCondition and strategy.position_size >= 0
    strategy.entry("Short", strategy.short, comment="Short Entry")
    strategy.exit("Exit Short", from_entry="Short", stop=takeProfit, limit=stopLoss)

// === VISUALIZATION ===
plot(smaValue, color=color.blue, title="SMA")
plot(upperBB, color=color.green, title="BB Upper")
plot(lowerBB, color=color.red, title="BB Lower")
plot(leadingSpanA, color=color.teal, title="Leading Span A")
plot(leadingSpanB, color=color.purple, title="Leading Span B")

plot(bullishCount, title="Bullish Signals", color=color.green)
plot(bearishCount, title="Bearish Signals", color=color.red)

